                  GH_AW_INFO_VERSION: "1.0.63"
                  GH_AW_INFO_AGENT_VERSION: "1.0.63"
                  GH_AW_INFO_WORKFLOW_NAME: "Test Job Environment Variables"
                  GH_AW_INFO_EXPERIMENTAL: "false"
